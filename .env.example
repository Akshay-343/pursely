POSTGRES_USER=money
POSTGRES_PASSWORD=money
POSTGRES_DB=moneytracker
# Generate with: openssl rand -hex 32   (required in production)
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Public URL of the app, used in email links (production: https://your-domain)
APP_URL=http://localhost:5173

# --- Email (welcome, password reset, reminders). Leave SMTP_HOST empty to disable email. ---
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# (16 characters, shown in groups of four; paste it without spaces). Gmail only sends "From" your own address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Money Tracker <your.address@gmail.com>

# --- Sign in with Google (optional). OAuth Client ID of type "Web application" from
# https://console.cloud.google.com/apis/credentials ; add your app URL under Authorized JavaScript origins. ---
GOOGLE_CLIENT_ID=

# Production only (docker-compose.prod.yml): the domain Caddy serves with automatic HTTPS
DOMAIN=money.example.com
